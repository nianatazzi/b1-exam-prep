# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Переменные окружения (Firebase конфиг, ключи)
.env

# Firebase config (содержат конфигурацию проекта — не коммитим)
android/app/google-services.json

# firebase.json / .firebaserc / functions/ — трекаются: секретов не содержат,
# ключ OpenAI хранится через Secret Manager (`firebase functions:secrets:set`)
functions/node_modules/

# Android build артефакты (корневой /build/ выше не покрывает android/build/)
android/build/

# Firebase Admin SDK service account key (полный админ-доступ к проекту)
scripts/seed/serviceAccountKey.json
scripts/seed/node_modules/
